# src/qrc/config.py

import numpy as np


def get_default_config():
    f0 = 1.75
    Js = 0.5
    gamma_scale = 0.2

    t_final = 5.0 / gamma_scale
    t_equi = 0 * t_final

    delta_t = 0.005 / gamma_scale

    n_qubits = 8

    n_steps = int(np.ceil(t_final / delta_t)) + 1
    t_eval = np.linspace(0.0, t_final, n_steps)
    t_span = [0.0, t_final]

    n_bet = 300
    Delta_t = delta_t * n_bet

    n_injects = int(n_steps / n_bet)

    n_samples = 10
    DeltaDelta_t = Delta_t / n_samples

    n_data = round(n_samples * n_injects)

    h_z = 1.5
    gamma = 0.01

    return {
        "f0": f0,
        "Js": Js,
        "gamma_scale": gamma_scale,
        "t_final": t_final,
        "t_equi": t_equi,
        "delta_t": delta_t,
        "n_qubits": n_qubits,
        "n_steps": n_steps,
        "t_eval": t_eval,
        "t_span": t_span,
        "n_bet": n_bet,
        "Delta_t": Delta_t,
        "n_injects": n_injects,
        "n_samples": n_samples,
        "DeltaDelta_t": DeltaDelta_t,
        "n_data": n_data,
        "h_z": h_z,
        "gamma": gamma,
    }
